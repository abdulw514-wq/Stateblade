{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "stateblade",
  "compatibility_date": "2026-08-01",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "TWITCH_CLIENT_ID": "PASTE_YOUR_TWITCH_CLIENT_ID_HERE",
    "KICK_CLIENT_ID": "PASTE_YOUR_KICK_CLIENT_ID_HERE",
    "DAILYMOTION_API_KEY": "4e0858c0a34987700092"
  }
}
